# URL base da API consumida pelo front-end em runtime.
# Em dev, deixe relativa ("/api") para passar pelo proxy do Vite (ver vite.config.ts)
# e evitar CORS sem precisar alterar o back-end. Em produção, aponte para a URL
# pública real da API (ex.: https://api.seudominio.com/api).
VITE_API_BASE_URL=/api

# Somente para o servidor de dev do Vite: para onde o proxy de /api deve encaminhar.
VITE_DEV_PROXY_TARGET=http://localhost:8080
